# Public domain managed by Caddy (automatic HTTPS via Let's Encrypt)
SITE_DOMAIN=xcodea.online
APP_BASE_URL=https://xcodea.online

# PostgreSQL connection (consumed by Docker Compose postgres + app services)
POSTGRES_PASSWORD=replace-with-strong-random-password
DATABASE_URL=postgresql://atoms:replace-with-strong-random-password@postgres:5432/atoms

# Core Adapters (Production)
STORAGE_ADAPTER=postgres
BUILDER_ADAPTER=esbuild
PUBLISHER_ADAPTER=same-origin
BILLING_ADAPTER=mock

# Strong random secret for @atoms/cloud JWT tokens & mock billing HMAC signatures
APP_AUTH_SECRET=replace-with-long-random-secret

# Real LLM Adapter & Models
LLM_ADAPTER=vercel-ai
DEFAULT_LLM_MODEL=deepseek:deepseek-v4-pro

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.7-code

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-latest
