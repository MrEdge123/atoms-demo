# Base URL of the running platform (used for published links and Creem return/webhook URLs)
APP_BASE_URL=http://localhost:3000

# LLM Adapter: mock | vercel-ai
LLM_ADAPTER=mock
DEFAULT_LLM_MODEL=mock-default

# Optional LLM Provider Credentials (unlocks real models in the workbench switcher)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-latest

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash,deepseek-v4-pro

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3.1-pro-highspeed,kimi-k2.6,kimi-k2.7-code-highspeed

# App Builder Adapter: mock | esbuild
BUILDER_ADAPTER=esbuild

# Storage Adapter: memory | pglite | postgres
STORAGE_ADAPTER=pglite
PGLITE_DATA_DIR=.data/pglite
DATABASE_URL=

# Site Publisher Adapter: memory | same-origin
PUBLISHER_ADAPTER=same-origin

# Billing Adapter: mock | creem
BILLING_ADAPTER=mock
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_ID=
CREEM_API_BASE_URL=https://test-api.creem.io/v1

# Signing secret for workbench session cookies (atoms_sid), generated-app user tokens & Mock webhooks
APP_AUTH_SECRET=dev-local-secret-change-in-production

# Cloud AI Proxy limits & rate limiting
AI_RATE_LIMIT_IP_PER_MIN=10
AI_RATE_LIMIT_PROJECT_PER_DAY=200
AI_PROXY_MAX_INPUT_CHARS=2000
AI_PROXY_MAX_TOKENS=512

# Cloud DB access control & pagination bounds
CLOUD_PUBLIC_COLLECTIONS=guestbook,messages,comments,feedback
CLOUD_DB_MAX_LIMIT=100
